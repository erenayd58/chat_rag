# Configuration for the container. No secrets belong in this file -- it is
# tracked, and `docker compose` reads it at run time rather than baking it into
# an image layer. Put anything private in .env.docker.local, which is ignored
# by git and, when present, overrides the values here.
#
# The local .env is deliberately NOT used by the container: it points at
# localhost, which inside a container means the container itself.

# ----------------------------------------------------------------------------
# Language model. Ollama runs on the host, not in this container.
# ----------------------------------------------------------------------------
# host.docker.internal resolves to the host from inside the container; the
# compose file maps it explicitly so this works on Linux as well as on Docker
# Desktop. Nothing in the code knows this address -- it arrives from here.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# With Ollama stopped the application still starts: uploading, parsing,
# chunking, structural QA and BM25 search all work, and only generation
# answers with an explanatory error.

# ----------------------------------------------------------------------------
# Pipeline. These are the frozen proof-of-concept selections.
# ----------------------------------------------------------------------------
CHUNKER_TYPE=structure_first
RETRIEVAL_PROFILE=bm25_only
DEFAULT_TOP_K=5

# Read by knowledge bases that do compute embeddings. Under bm25_only the
# pipeline builds a NullEmbedding and no model is downloaded or loaded, so
# this name is recorded in the configuration snapshot and never used.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
# The reloader would build the pipeline twice and the interactive debugger has
# no place in a container.
FLASK_DEBUG=false
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Deep Analysis boundary judge (optional). Unset means Deep Analysis uploads
# are refused with a clear configuration error; Standard is unaffected. Put
# the actual API key in .env.docker.local (git-ignored), never here.
# ----------------------------------------------------------------------------
# BOUNDARY_JUDGE_MODEL=
# BOUNDARY_JUDGE_ENDPOINT=
# BOUNDARY_JUDGE_API_KEY_ENV=OPENROUTER_API_KEY
