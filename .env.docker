# Configuration for the container. No secrets belong in this file -- it is
# tracked, and `docker compose` reads it at run time rather than baking it into
# an image layer. Put anything private in .env.docker.local, which is ignored
# by git and, when present, overrides the values here.
#
# The local .env is deliberately NOT used by the container: it points at
# localhost, which inside a container means the container itself.
#
# Every value here is a DELIBERATE deployment override or a default restated
# for visibility. tests/unit/test_configuration.py requires each difference
# from the application default to be listed there with a reason, so this file
# cannot quietly become a second source of truth. Precedence and the full map
# are in docs/configuration.md.

# ----------------------------------------------------------------------------
# Language model. Ollama runs on the host, not in this container.
# ----------------------------------------------------------------------------
# host.docker.internal resolves to the host from inside the container; the
# compose file maps it explicitly so this works on Linux as well as on Docker
# Desktop. Nothing in the code knows this address -- it arrives from here.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# With Ollama stopped the application still starts: uploading, parsing,
# chunking, structural QA and BM25 search all work, and only generation
# answers with an explanatory error.

# ----------------------------------------------------------------------------
# Pipeline. These are the frozen proof-of-concept selections.
# ----------------------------------------------------------------------------
CHUNKER_TYPE=structure_first
# bm25_only needs no provider at all. hybrid_rrf (dense + BM25 + RRF) is the
# final chain and needs EMBEDDING_* plus OPENROUTER_API_KEY in .env.docker.local.
RETRIEVAL_PROFILE=bm25_only
# RETRIEVAL_PROFILE=hybrid_rrf
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# ANSWER_PROVIDER=openrouter
# ANSWER_MODEL=minimax/minimax-m2.7
# ANSWER_FALLBACK_PROVIDER=ollama
# ANSWER_FALLBACK_MODEL=qwen2.5:3b
DEFAULT_TOP_K=5

# Read by knowledge bases that do compute embeddings. Under bm25_only the
# pipeline builds a NullEmbedding and no model is downloaded or loaded, so
# this name is recorded in the configuration snapshot and never used.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
# The container runs `python -m wsgi`: waitress, one process, with no reloader
# and no interactive debugger to switch off in the first place. FLASK_DEBUG is
# kept for `docker compose exec app python app.py`, which is a debugging
# gesture rather than how the service runs.
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Request threads. This is the whole of the application's request concurrency:
# one process, this many threads, plus the one Viewer packaging thread. Raise
# it for more concurrent users; lower it to cap how many uploads can parse at
# once on a small machine.
WAITRESS_THREADS=8

# Bounded queries (env.example documents each). Left at their defaults here:
# QUERY_MAX_ACTIVE derives from the thread count so that questions and
# synchronous uploads together never take every request thread.
# QUERY_MAX_ACTIVE=
# ANSWER_MAX_INFLIGHT=4
# QUERY_TIMEOUT=180
# ANSWER_SLOT_WAIT=30

# Signs the session cookie. Left unset, each start generates a random key, so
# sessions do not survive a restart -- harmless here, because the cookie only
# carries a session id used to pick a cached pipeline. Set it in
# .env.docker.local, never here, for a deployment that should keep them.
# FLASK_SECRET_KEY=

# ----------------------------------------------------------------------------
# Logging. The container writes /data/logs/rag_<timestamp>.log as well as to
# stdout, and bounds it itself: LOG_MAX_BYTES x (LOG_BACKUPS + 1) per run, and
# LOG_RUNS_KEPT runs before the oldest are removed.
# ----------------------------------------------------------------------------
# INFO is the default in the code and is what this deployment runs. It carries
# every operational event, start-up line and error, and no document content.
# DEBUG additionally writes full prompts, retrieved chunks and answer context
# into the log file, so set it only in .env.docker.local while debugging, and
# unset it afterwards.
LOG_FILE_LEVEL=INFO
# LOG_MAX_BYTES=10485760
# LOG_BACKUPS=3
# LOG_RUNS_KEPT=10

# ----------------------------------------------------------------------------
# Deep Analysis (optional). With the model or key unset, Deep Analysis uploads
# complete on the deterministic quality contract and are labelled as such;
# Standard is unaffected. Put the actual API key in .env.docker.local
# (git-ignored), never here.
# ----------------------------------------------------------------------------
# DEEP_ANALYSIS_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# DEEP_ANALYSIS_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# DEEP_ANALYSIS_API_KEY_ENV=OPENROUTER_API_KEY
# DEEP_ANALYSIS_VERIFY=true
