# /Users/murseltasgin/projects/chat_rag/.gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# Environment variables. .env holds whichever provider keys this machine
# uses; env.example is the tracked template and .env.docker the tracked,
# secret-free container configuration.
.env

# Vector database
chroma_db/

# Document tracking
.ingested_documents.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Logs
*.log

# Test output
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# NLTK data (downloaded at runtime)
nltk_data/
logs/*
chroma_db/*
documents/*
archive/*
docs/*
# Regenerable caches: canonical units from the structured PDF parser,
# plus the embedding caches used by the comparison profiles.
.cache/
*.bak

# Runtime gold set: whatever the reviewer has marked in the UI so far. It is
# mutable working state, not a regression set -- freeze one with
# `python -m cli gold export` into artifacts/gold/ and commit that instead.
.gold_set.json

# Evaluation runs and QA report packages are regenerable from production
# state, and a report carries the whole exported corpus. Frozen gold sets
# under artifacts/gold/ are not regenerable, so they stay tracked.
artifacts/runs/
artifacts/reports/

# Viewer v2 analyses of this console's own documents: one directory per
# ingested document, rebuilt from that ingest whenever it is missing. Live
# workspace state, never a frozen benchmark artifact.
artifacts/viewer-live/

# Docker runtime data: the container's own knowledge bases, vector stores,
# canonical-unit cache, logs and evaluation output. Never mixed with the local
# development state above.
.docker-data/

# Private container configuration; .env.docker holds the tracked, secret-free
# defaults.
.env.docker.local

# Knowledge base records: runtime state written by the application, not
# configuration. Committing it publishes whichever knowledge bases happen to
# exist on one machine; the file is recreated on demand when absent.
.knowledge_bases.json

# Demo launcher runtime state: logs and the process ids start-demo.ps1
# started (stop-demo.ps1 reads them). Local, regenerable, never committed.
.demo/
