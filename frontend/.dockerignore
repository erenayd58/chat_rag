# The install and the build are done inside the image, from package-lock.json
# and the source. A node_modules copied in from the host would be the wrong
# platform's binaries, and a .next copied in would be a build nobody can
# reproduce.
node_modules/
.next/
out/
*.tsbuildinfo

# Generated by `next build`; not an input to one.
next-env.d.ts

# Tests do not run in the image, and the live suite needs a server that is not
# there at build time.
tests/

# Never in an image layer.
.env
.env.*
.git/
.gitignore
.vscode/
.idea/
Dockerfile
.dockerignore
