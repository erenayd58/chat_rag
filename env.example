# Example .env configuration
#
# HOW THIS FILE IS READ
# ---------------------
# Copy it to .env. Precedence, highest first:
#
#   1. the real process environment  -- what a container, compose, a test or
#      your shell actually exported. Always wins.
#   2. this file (as .env)           -- applied by config/__init__.py, once,
#      before any config module reads anything.
#   3. the application default       -- written on the setting's own dataclass
#      field in config/runtime.py, config/ingest.py, config/query.py, or in
#      the os.getenv() call in config/settings.py.
#
# One exception, and it is deliberate: a state path (STRUCTURED_PARSER_CACHE)
# from .env is ignored when CHAT_RAG_DATA_DIR is set.
# .env describes a developer's local layout, and a deployment that declared
# where its state lives must not have it moved by a leftover file. Set the
# variable in the real environment to override that. See config/paths.py.
#
# LINES THAT ARE COMMENTED OUT show the application default -- uncomment only
# to change it. LINES THAT ARE NOT commented out are the demo profile: they
# deliberately differ from the defaults, because the defaults are the
# conservative no-provider ones. tests/unit/test_configuration.py holds both
# halves of that to the code, so this file cannot drift.
#
# docs/configuration.md is the full map. No secret belongs in a committed
# file; keep keys in .env, which is git-ignored.

# ============================================================================
# LLM Provider Selection
# ============================================================================
# The answer model (chat generation). ANSWER_PROVIDER: 'openrouter' (any
# OpenAI-compatible chat-completions gateway; 'openai_compatible' and
# 'openai-compatible' name the same one), 'ollama' or 'azure'. The final
# chain answers with minimax/minimax-m2.7 through OpenRouter and keeps the
# local Ollama model as the fallback when the gateway cannot be reached.
# LLM_PROVIDER ('azure' or 'ollama') is still honoured when ANSWER_PROVIDER
# is unset.
ANSWER_PROVIDER=openrouter
ANSWER_MODEL=minimax/minimax-m2.7
# ANSWER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# ANSWER_API_KEY_ENV=OPENROUTER_API_KEY
# ANSWER_TIMEOUT=120
ANSWER_FALLBACK_PROVIDER=ollama
ANSWER_FALLBACK_MODEL=qwen2.5:3b
# One key for every OpenRouter role (Deep Analysis, embeddings, answers).
# Never committed; the application only ever reads it at request time.
# OPENROUTER_API_KEY=
LLM_PROVIDER=ollama

# ============================================================================
# Azure OpenAI Configuration (when LLM_PROVIDER=azure)
# ============================================================================
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your-api-key
AZURE_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-02-15-preview

# ============================================================================
# Ollama Configuration (when LLM_PROVIDER=ollama)
# ============================================================================
# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use
# Popular models: llama2, mistral, codellama, mixtral, phi, gemma
# Install models: ollama pull <model-name>
OLLAMA_MODEL=llama2

# Request timeout in seconds (increase for larger models)
OLLAMA_TIMEOUT=120

# ============================================================================
# Embedding Model Configuration
# ============================================================================
# Dense retrieval embeddings (documents and queries share one model/space).
# EMBEDDING_PROVIDER: 'openrouter' (any OpenAI-compatible /embeddings gateway)
# or 'sentence_transformers' (local model). The final chain uses
# qwen/qwen3-embedding-8b through OpenRouter with RETRIEVAL_PROFILE=hybrid_rrf.
# The vector store records which model wrote it; changing the model marks the
# knowledge base "re-index required" instead of searching a foreign space.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
# EMBEDDING_API_KEY_ENV=OPENROUTER_API_KEY
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT=120
# EMBEDDING_CONCURRENCY=4
# EMBEDDING_DIMENSIONS=            # only for models that accept a reduced size
# Local alternative:
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# Where this application's relational state lives: the knowledge bases, the
# ingest ledger, the content identities and their analysis state, the ingest
# journal and the gold set. There is no application default and there cannot
# be one -- the only fallback would be a credential written into a tracked
# file -- so this is the one setting the process refuses to start without.
#
# The value below is the local development database that
# `docker compose -f docker-compose.test.yml up -d` starts, on a non-standard
# port so it cannot collide with a PostgreSQL already installed on the machine.
# A deployment sets its own in the real environment; the container gets it from
# .env.docker, pointing at the compose service.
#
# Create the schema before first use, and after every upgrade:
#     alembic upgrade head
DATABASE_URL=postgresql+psycopg://chat_rag:chat_rag@127.0.0.1:55432/chat_rag

# The connection pool, per process. The runtime is one process with
# WAITRESS_THREADS request threads plus INGEST_WORKERS job workers and one
# packaging thread, and a connection is held only for the length of one unit of
# work -- so the default covers every thread that can be inside a session at
# once without a connection per thread.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# Seconds a caller waits for a connection before the pool gives up, seconds
# after which an idle connection is replaced, and seconds to wait for the TCP
# connection itself. The last one is why an unreachable database is a start-up
# message rather than a process that hangs.
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_CONNECT_TIMEOUT=10
# Log every statement. Development only: the log is not redacted.
# DATABASE_ECHO=false

# --- the schema, at start-up -------------------------------------------------
# The container brings the database to head before it serves
# (docker-entrypoint.sh runs `python -m tools.migrate`). Nothing in the
# application creates a table: that step is still Alembic, still reviewable,
# and it logs the revision it moved from and to.
#
# Turn it off for a deployment that applies its schema as a separate step. The
# application then starts against whatever schema is there and fails on the
# first query if that schema is behind.
# CHAT_RAG_MIGRATE_ON_START=1
#
# How long that step waits for a database that is accepting connections but
# still recovering. `docker compose` releases the application container the
# moment the database's health check passes, which is a few seconds before it
# is really ready; without this the container would exit and be restarted until
# the timing happened to work. Past it, a wrong DATABASE_URL is reported by
# name rather than retried forever.
# CHAT_RAG_DB_WAIT=60

# ============================================================================
# Vector Database Configuration
# ============================================================================
# There is nothing to point at a vector store any more: the chunks and their
# embeddings are rows in the PostgreSQL database named by DATABASE_URL above,
# in a `vector_collections` / `chunk_vectors` pair created by
# `alembic upgrade head`. A knowledge base's collection is its own id.
#
# The one setting left names the collection the console uses when *no*
# knowledge base is selected. There is rarely a reason to change it; two
# deployments sharing one database and wanting separate default corpora is
# the reason it exists.
# VECTOR_DB_COLLECTION=documents

# ============================================================================
# Runtime state and server
# ============================================================================
# One directory for everything this application persists *as a file*: the
# parser's canonical-unit cache, the packaged Viewer artifacts, the embedding
# caches, the upload staging area and the logs. The records and the vectors
# are in PostgreSQL above. Unset -- the local default --
# every path stays exactly where it has always been, relative to the working
# directory. The container sets it to /data.
# CHAT_RAG_DATA_DIR=

# The parser's canonical-unit cache. Derived from CHAT_RAG_DATA_DIR when that
# is set; name it here only to put the cache somewhere else on purpose.
# STRUCTURED_PARSER_CACHE=

# Where the server listens (python -m asgi, uvicorn). One entrypoint: the
# Flask console that had a second one was removed in Step 13. The names are
# what every .env and compose file already carries, so they were not renamed
# with the framework.
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5005

# Request threads. One process; this is the whole of the application's request
# concurrency, alongside one Viewer packaging thread. It sizes the pool
# Starlette runs the synchronous handlers in.
# WAITRESS_THREADS=8
# WAITRESS_CHANNEL_TIMEOUT=900

# Bounded ingest. An upload is a
# job: at most INGEST_WORKERS run at once -- this bounds parsing, chunking
# and any local embedding model -- and at most INGEST_QUEUE_CAPACITY wait
# behind them. A submission beyond that is refused with 503 and a
# Retry-After, never queued anyway. One ingest runs per knowledge base at a
# time; different knowledge bases run in parallel up to the worker count.
# INGEST_WORKERS=2
# INGEST_QUEUE_CAPACITY=8
# Seconds a job may run once started. Checked between stages and before
# every model call, never inside a store write; a job past it ends as
# timed_out with nothing committed.
# INGEST_JOB_TIMEOUT=1800
# Seconds a synchronous upload waits for its job before answering with the job
# to poll. Keep it below WAITRESS_CHANNEL_TIMEOUT. /api/v1 has never offered a
# synchronous upload -- POST /api/v1/documents always answers 202 -- so this
# and INGEST_SYNC_WAITERS bound an application path with no HTTP caller today;
# what they still decide is the thread ration below.
# INGEST_SYNC_WAIT=840
# How many request threads may be reserved for such a wait. Defaults to half
# of WAITRESS_THREADS. It is subtracted from the QUERY_MAX_ACTIVE default, so
# questions can never take every request thread and /api/v1/health and job
# polling always have one to land on.
# INGEST_SYNC_WAITERS=
# Seconds a finished job stays queryable at /api/v1/ingest-jobs/<id>. The same
# window applies to the on-disk job records a restart answers from.
# INGEST_JOB_RETENTION=3600
# Process-wide cap on Deep Analysis proposer and verifier calls in flight,
# shared by every running Deep job. Standard, Markdown and Viewer packaging
# make no such call. DEEP_ANALYSIS_CONCURRENCY (below) is one job's own pool;
# all jobs together never exceed this.
# PROVIDER_MAX_INFLIGHT=8
# Process-wide cap on embedding requests in flight, when EMBEDDING_PROVIDER is
# a remote endpoint. Separate from the Deep cap because the two reach
# different services and neither should starve the other, and because
# embeddings multiply from places Deep Analysis does not run: every ingest,
# a whole-knowledge-base re-index, and every query.
# EMBEDDING_MAX_INFLIGHT=4
# How many built pipelines may be held, and how long an unused one is kept.
# A pipeline holds an embedding model, a vector store handle and the whole
# knowledge base's lexical index, so this is the largest single memory dial
# in the process. One is built per browser session per knowledge base;
# eviction closes the store and never touches a pipeline that is in use.
# PIPELINE_CACHE_MAX=8
# PIPELINE_CACHE_TTL=1800

# Bounded queries. A question runs on the request thread that received it
# (retrieval, context assembly and the answer-model call all happen there),
# so what multiplies under load is request threads held for a provider call.
# How many request threads may be inside a query at once. A question that
# finds no slot is refused at once with 503, overloaded: true and a
# Retry-After -- never queued, because a queued question would hold the very
# thread this keeps free. Defaults to WAITRESS_THREADS - INGEST_SYNC_WAITERS - 1
# so that questions can never take every request thread, and /api/v1/health
# and job polling always have one to land on.
# QUERY_MAX_ACTIVE=
# Process-wide cap on answer-model calls in flight, shared by every session.
# A third budget, separate from PROVIDER_MAX_INFLIGHT (Deep Analysis) and
# EMBEDDING_MAX_INFLIGHT: an answer is one long interactive completion a
# person is watching, a Deep call is one short vote among dozens made in bulk
# from a background worker, and the fallback answer model is a local Ollama
# whose cost is this host's CPU. Sharing one cap would let either path starve
# the other; separate caps give each a floor whatever the other is doing.
# ANSWER_MAX_INFLIGHT=4
# Seconds a question may take in total. Cooperative, with the network
# boundary enforced: checked before every outbound call and while waiting for
# an answer slot, and each answer attempt's socket timeout is clamped to the
# time left (a retry there is no time for is skipped). A stage already
# running -- a lexical index rebuild, a store lookup, a local model, an Ollama
# call -- runs to its end. Answered 504 when it passes.
# QUERY_TIMEOUT=180
# Longest a question waits for an answer-model slot before it is refused as
# answer_capacity overload (503 with a Retry-After), whatever its deadline
# still allows. Short on purpose: "busy, try again" in seconds beats an answer
# two minutes late.
# ANSWER_SLOT_WAIT=30

# Logging. The application writes logs/rag_<timestamp>.log under the data root
# itself, so it is responsible for bounding it: LOG_MAX_BYTES x (LOG_BACKUPS+1)
# per run, and LOG_RUNS_KEPT runs before the oldest are deleted.
# LOG_MAX_BYTES=10485760
# LOG_BACKUPS=3
# LOG_RUNS_KEPT=10
# The file handler's level. INFO is the default and is what a deployment
# should run: the operational events, start-up and errors are all at INFO and
# carry no content. DEBUG additionally writes this system's request and
# retrieval dumps -- full prompts, retrieved chunks and answer context -- to
# the log file, so it is a deliberate choice for local debugging and not a
# thing to leave on. An unrecognised value falls back to INFO.
# LOG_FILE_LEVEL=INFO

# ============================================================================
# Chunking Configuration
# ============================================================================
# Which indexing chunker a knowledge base is created with when its own record
# does not say. structure_first is the product's; v4 is the frozen AMSC V4/A4
# package, for comparison against the library's benchmark.
# CHUNKER_TYPE=structure_first

# ============================================================================
# Retrieval Configuration
# ============================================================================
# bm25_only (the default) is the frozen deterministic BM25 alone and needs no
# provider. hybrid_rrf is the final chain: dense (EMBEDDING_*) + BM25, fused
# by RRF, with a bounded labelled context the answer model must cite.
# benchmark_aligned is the frozen Phase 4/5 E5 + BM25 + equal-weight RRF
# configuration. Retrieval is deterministic in all three.
RETRIEVAL_PROFILE=hybrid_rrf
# CONTEXT_MAX_TOKENS=3200
# CONTEXT_MAX_SOURCES=8
# CONTEXT_EXPAND_NEIGHBORS=true
DEFAULT_TOP_K=5

# ============================================================================
# Logging  (utils/logger.py owns these)
# ============================================================================
# Logging is the one group that does NOT refuse to start on a bad value: an
# unrecognised level falls back to INFO and says so at start-up. The risky
# direction is DEBUG -- the file handler writes prompts, retrieved chunks and
# answer context to disk -- so a typo must never be what turns that on, and a
# logging typo must not take the service down either. Everything else in this
# file fails fast. See docs/configuration.md.
#
# The console handler's level. DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO
#
# The *file* handler's level, and the one that matters: at DEBUG the log file
# gets full prompts and full retrieved chunk text. Deliberately separate.
# LOG_FILE_LEVEL=INFO
#
# Rotation, so one long run cannot fill the disk, and how many past runs are
# kept, so restarts cannot either. Worst case on disk is
# LOG_MAX_BYTES * (LOG_BACKUPS + 1) * LOG_RUNS_KEPT.
# LOG_MAX_BYTES=10485760
# LOG_BACKUPS=3
# LOG_RUNS_KEPT=10


# Deep Analysis (the premium ingest mode; backend ingest only, never called
# at query time). Any OpenAI-compatible chat-completions endpoint works --
# OpenRouter, a company gateway, or a local server. DEEP_ANALYSIS_API_KEY_ENV
# names the environment variable that holds the key; the key itself is read
# at request time and never stored, logged or written to provenance. With
# the model or the key unset, Deep Analysis uploads still complete: the
# deterministic quality contract runs alone and the document is labelled
# "completed with deterministic fallback" rather than passed off as Standard.
# DEEP_ANALYSIS_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# DEEP_ANALYSIS_VERIFIER_MODEL=            # optional; defaults to the proposer model
# DEEP_ANALYSIS_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# DEEP_ANALYSIS_API_KEY_ENV=OPENROUTER_API_KEY
# DEEP_ANALYSIS_VERIFY=true                # double-order verifier on accepted changes
# DEEP_ANALYSIS_USE_LLM=true               # false = deterministic quality pass only
# DEEP_ANALYSIS_TIMEOUT=120
# DEEP_ANALYSIS_CONCURRENCY=8
# (The earlier BOUNDARY_JUDGE_MODEL/ENDPOINT/API_KEY_ENV/TIMEOUT names are
# still read as a fallback.)
